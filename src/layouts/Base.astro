---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { Font } from 'astro:assets';
import { sitio, esPendiente } from '../lib/sitio';
import '../styles/global.css';

const { titulo = sitio.seo.titulo, descripcion = sitio.seo.descripcion } = Astro.props;
const dominio = esPendiente(sitio.marca.dominio) ? null : sitio.marca.dominio.replace(/\/$/, '');
const base = import.meta.env.BASE_URL;
// La imagen para compartir (1200×630) se arma en el paso 6; mientras no exista, no se anuncia.
const hayImagen = existsSync(join(process.cwd(), 'public', 'compartir-og.png'));
const imagenCompartir = (dominio ?? '') + base.replace(/\/?$/, '/') + 'compartir-og.png';
---
<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta name="theme-color" content="#0B0F14" />
    {dominio && <link rel="canonical" href={dominio + '/'} />}
    <link rel="icon" href={base.replace(/\/?$/, '/') + 'favicon.svg'} type="image/svg+xml" />

    <!-- Vista previa al compartir (WhatsApp, Facebook, etc.) -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content={sitio.marca.nombre} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    {hayImagen && <meta property="og:image" content={imagenCompartir} />}
    {hayImagen && <meta property="og:image:width" content="1200" />}
    {hayImagen && <meta property="og:image:height" content="630" />}
    {dominio && <meta property="og:url" content={dominio + '/'} />}
    <meta name="twitter:card" content="summary_large_image" />

    <Font cssVariable="--fuente-ui" preload />
    <Font cssVariable="--fuente-pantalla" />
  </head>
  <body>
    <slot />
  </body>
</html>
