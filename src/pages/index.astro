---
import Base from '../layouts/Base.astro';
import Encabezado from '../components/Encabezado.astro';
import Portada from '../components/Portada.astro';
import Muestra from '../components/Muestra.astro';
import VideosTikTok from '../components/VideosTikTok.astro';
import Funciones from '../components/Funciones.astro';
import ComoFunciona from '../components/ComoFunciona.astro';
import Versiones from '../components/Versiones.astro';
import Pie from '../components/Pie.astro';
---
<Base>
  <Encabezado />
  <main>
    <Portada />
    <Muestra />
    <VideosTikTok />
    <Funciones />
    <ComoFunciona />
    <Versiones />
    <!-- Próximos pasos: Ideas de regalo · Opiniones · Preguntas · Contacto -->
    <section class="contenedor proximo" aria-label="Próximamente">
      <p class="mono">[ Aquí siguen las demás secciones, paso a paso ]</p>
    </section>
  </main>
  <Pie />
</Base>

<style>
  .proximo {
    padding-block: 48px;
    text-align: center;
    color: var(--texto-2);
    font-size: 14px;
    border-top: 1px dashed var(--borde);
  }
</style>
