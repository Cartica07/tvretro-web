---
import Base from '../layouts/Base.astro';
import Encabezado from '../components/Encabezado.astro';
import Portada from '../components/Portada.astro';
import Pie from '../components/Pie.astro';
---
<Base>
  <Encabezado />
  <main>
    <Portada />
    <!-- Próximos pasos: Mira lo que puede mostrar · Funciones · Versiones (#versiones) ·
         Cómo funciona · Ideas de regalo · Opiniones · Preguntas · Contacto -->
    <section id="versiones" class="contenedor proximo" aria-label="Próximamente">
      <p class="mono">[ Aquí siguen las demás secciones, paso a paso ]</p>
    </section>
  </main>
  <Pie />
</Base>

<style>
  .proximo {
    padding-block: 48px;
    text-align: center;
    color: var(--texto-2);
    font-size: 14px;
    border-top: 1px dashed var(--borde);
  }
</style>
