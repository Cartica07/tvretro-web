---
import { sitio, enlaceRed } from '../lib/sitio';
import BotonWhatsApp from './BotonWhatsApp.astro';
import TvMadera from './TvMadera.astro';

const p = sitio.portada;
// "*palabra*" → palabra resaltada.
const partesTitulo = p.titulo.split(/(\*[^*]+\*)/).filter(Boolean).map((t) =>
  t.startsWith('*') ? { brillo: true, t: t.slice(1, -1) } : { brillo: false, t },
);
const tiktok = enlaceRed('tiktok');
const seguidores = sitio.tiktok.seguidores.trim();
const datosPantalla = JSON.stringify({ mensajes: sitio.pantalla.mensajes });
---
<section class="portada" id="inicio" aria-labelledby="portada-titulo">
  <div class="contenedor portada-grid">
    <div class="portada-texto">
      <h1 id="portada-titulo" class="entra" style="--i: 0">
        {partesTitulo.map((x) => (x.brillo ? <span class="brillo">{x.t}</span> : x.t))}
      </h1>
      <p class="portada-subtitulo entra" style="--i: 1">{p.subtitulo}</p>
      {p.destacados.length > 0 && (
        <ul class="destacados entra" style="--i: 2" aria-label="Lo más destacado">
          {p.destacados.map((d) => <li>{d}</li>)}
        </ul>
      )}
    </div>

    <div class="portada-tv entra" style="--i: 2">
      <figure class="tv" data-pantalla={datosPantalla}>
        <TvMadera etiqueta="Pantalla de Pepito mostrando mensajes, una foto, un GIF y una canción con letra" />
        <figcaption class="solo-lectores">Pepito, el televisorcito de madera, con su pantalla mostrando lo que le envías desde el celular.</figcaption>
      </figure>

      <div class="portada-controles">
      <button class="boton-sonido" type="button" aria-pressed="false" aria-describedby="nota-volumen">
        <span class="bs-icono" aria-hidden="true">
          <svg class="bs-play" viewBox="0 0 24 24"><path d="M8 5.5v13l10.5-6.5L8 5.5Z" fill="currentColor" /></svg>
          <span class="bs-barras"><i></i><i></i><i></i></span>
        </span>
        <span class="bs-texto" data-tocar={p.botonSonido} data-detener="Detener">{p.botonSonido}</span>
        <svg class="bs-parlante" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4v-5Z" fill="currentColor" /><path d="M15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
      </button>
      <!-- Pausa: lo que se mueve más de 5 s necesita una forma de detenerlo (accesibilidad). -->
      <button class="boton-pausa" type="button" aria-pressed="false" aria-label="Pausar la pantalla" data-pausar="Pausar la pantalla" data-seguir="Seguir mostrando">
        <svg class="bp-pausa" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5h2.6v13H8zM13.4 5.5H16v13h-2.6z" fill="currentColor" /></svg>
        <svg class="bp-seguir" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5L8 5.5Z" fill="currentColor" /></svg>
      </button>
      </div>
    </div>

    <p id="nota-volumen" class="solo-lectores">Sube el volumen: suena como Pepito de verdad.</p>

    <div class="portada-acciones entra" style="--i: 3">
      <div class="portada-botones">
        <BotonWhatsApp texto={p.botonPrincipal} />
        <a class="boton boton-secundario" href="#versiones">{p.botonSecundario}</a>
      </div>
    </div>

    {seguidores && (
      <div class="portada-social entra" style="--i: 4">
        <p class="prueba-social">
          <span class="ps-numero">+{seguidores}</span>
          <span>
            personas siguen sus canciones en TikTok.{' '}
            {tiktok ? (
              <a href={tiktok} target="_blank" rel="noopener">Escúchalas aquí</a>
            ) : (
              <span class="pendiente">PENDIENTE: usuario de TikTok</span>
            )}
          </span>
        </p>
      </div>
    )}
  </div>
</section>

<script>
  import { PantallaApp } from '../scripts/oled/pantallaApp';
  import { buzzer } from '../scripts/oled/buzzer';
  import { fotoDemo, convertirFoto, gifDemo, cuadrosGif, listaCanciones, cargarCancion } from '../scripts/oled/contenidos';

  const figura = document.querySelector<HTMLElement>('.tv[data-pantalla]');
  const lienzo = figura?.querySelector('canvas');
  if (figura && lienzo) {
    const { mensajes } = JSON.parse(figura.dataset.pantalla!) as { mensajes: string[] };
    const sinMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const pantalla = new PantallaApp(lienzo);

    // Lo que va mostrando sola: todo con el código de la app.
    type Paso = { dura: number; mostrar: () => Promise<void> | void };
    const pasos: Paso[] = [];
    const msj = (i: number) => mensajes[i % mensajes.length];
    pasos.push({ dura: 3200, mostrar: () => pantalla.texto({ texto: msj(0) }) });
    pasos.push({ dura: 3600, mostrar: async () => pantalla.imagen(convertirFoto(await fotoDemo(), { umbral: 127, dithering: true })) });
    pasos.push({ dura: 3200, mostrar: () => pantalla.texto({ texto: msj(1) }) });
    pasos.push({ dura: 3600, mostrar: async () => pantalla.animacion(cuadrosGif(await gifDemo(), { umbral: 127, dithering: false })) });
    pasos.push({ dura: 6500, mostrar: () => pantalla.texto({ texto: msj(2), tamano: 3, modoTexto: 'scroll' }, !sinMovimiento) });
    pasos.push({ dura: 3200, mostrar: () => pantalla.texto({ texto: msj(3) }) });

    let indice = 0;
    let temporizador = 0;
    let corriendo = false;
    let ocupada = false; // sonando la canción
    const siguiente = async () => {
      if (!corriendo || ocupada) return;
      const paso = pasos[indice];
      indice = (indice + 1) % pasos.length;
      try { await paso.mostrar(); } catch (e) { console.warn('[Pepito]', e); }
      if (corriendo && !ocupada && !sinMovimiento) temporizador = window.setTimeout(siguiente, paso.dura);
    };
    const iniciar = () => { if (corriendo) return; corriendo = true; void siguiente(); };
    const pausar = () => { corriendo = false; clearTimeout(temporizador); if (!ocupada) pantalla.detener(); };

    let visible = true;
    let pausadaPorTi = false;
    const actualizar = () => (visible && !document.hidden && !pausadaPorTi ? iniciar() : pausar());

    const botonPausa = document.querySelector<HTMLButtonElement>('.boton-pausa')!;
    if (sinMovimiento) botonPausa.hidden = true; // ya está quieta
    botonPausa.addEventListener('click', () => {
      pausadaPorTi = !pausadaPorTi;
      botonPausa.setAttribute('aria-pressed', String(pausadaPorTi));
      botonPausa.setAttribute('aria-label', pausadaPorTi ? botonPausa.dataset.seguir! : botonPausa.dataset.pausar!);
      actualizar();
    });
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; actualizar(); }).observe(lienzo);
    document.addEventListener('visibilitychange', actualizar);

    // "Escucha cómo suena": la canción de muestra, con letra y sonido, como en la app.
    const boton = document.querySelector<HTMLButtonElement>('.boton-sonido')!;
    const etiqueta = boton.querySelector<HTMLElement>('.bs-texto')!;
    const marcar = (si: boolean) => {
      boton.setAttribute('aria-pressed', String(si));
      figura.classList.toggle('tv-sonando', si);
      etiqueta.textContent = si ? etiqueta.dataset.detener! : etiqueta.dataset.tocar!;
    };
    const terminar = () => {
      marcar(false);
      ocupada = false;
      pantalla.detener();
      clearTimeout(temporizador);
      if (corriendo) void siguiente();
      else if (pausadaPorTi) void pasos[(indice + pasos.length - 1) % pasos.length].mostrar();
    };
    boton.addEventListener('click', async () => {
      if (ocupada) { buzzer.detener(); return; }
      ocupada = true;
      clearTimeout(temporizador);
      marcar(true);
      try {
        const [primera] = await listaCanciones();
        const grab = await cargarCancion(primera.clave);
        if (!ocupada) return;
        buzzer.tocar(grab.notas, grab.duracion, terminar);
        pantalla.musical(grab, () => buzzer.tiempo());
      } catch (e) {
        console.warn('[Pepito]', e);
        terminar();
      }
    });
  }
</script>

<style>
  .portada { padding-block: clamp(28px, 6vw, 72px) clamp(40px, 8vw, 96px); }

  .portada-grid {
    display: grid;
    gap: 24px;
    /* 1: en celular, los botones van antes de la TV para que se vean en la primera pantalla */
    grid-template-areas: "texto" "acciones" "tv" "social";
  }
  .portada-social { grid-area: social; }
  .portada-texto { grid-area: texto; }
  .portada-tv { grid-area: tv; }
  .portada-acciones { grid-area: acciones; }

  @media (min-width: 900px) {
    .portada-grid {
      grid-template-columns: 1.05fr 1fr;
      grid-template-areas: "texto tv" "acciones tv" "social tv";
      column-gap: 56px;
      row-gap: 32px;
      align-items: center;
    }
    .portada-texto { align-self: end; }
    .portada-acciones { align-self: start; }
    .portada-social { align-self: start; margin-top: -10px; }
  }

  h1 {
    font-size: clamp(38px, 9.5vw, 60px);
    font-weight: 700;
    text-wrap: balance;
  }
  .brillo {
    color: var(--acento);
    text-shadow: 0 0 18px rgb(77 210 255 / .55), 0 0 2px rgb(77 210 255 / .9);
  }
  .portada-subtitulo {
    margin-top: 16px;
    max-width: 34ch;
    color: var(--texto-2);
    font-size: clamp(17px, 2.2vw, 20px);
  }

  /* 5: los datos clave, como una línea de texto y no como cajitas */
  .destacados {
    list-style: none;
    margin: 14px 0 0;
    line-height: 1.7;
    padding: 0;
    color: var(--texto);
    font-size: 15px;
    font-weight: 600;
  }
  .destacados li { display: inline; }
  .destacados li:not(:last-child)::after {
    content: "";
    display: inline-block;
    width: 5px; height: 5px;
    margin: 0 10px;
    vertical-align: middle;
    background: var(--acento);
    box-shadow: 0 0 6px var(--acento);
  }

  /* ---------- La TV ---------- */
  .portada-tv { display: grid; justify-items: center; gap: 14px; }

  .tv {
    margin: 0;
    width: min(100%, 440px);
  }
  /* 2: en celular, la TV de cerca: la pantalla queda de ~200 px de ancho y las patas se cortan */
  @media (max-width: 599px) {
    .tv {
      width: calc(100% + 2 * var(--margen));
      margin-inline: calc(-1 * var(--margen));
      aspect-ratio: 1 / 0.92;
      overflow: hidden;
      position: relative;
    }
    .tv :global(.tvm) { width: 158%; margin-left: -7.2%; margin-top: -9%; }
    .tv::after {
      content: "";
      position: absolute;
      inset: auto 0 0 0;
      height: 18%;
      background: linear-gradient(to bottom, transparent, var(--fondo));
      pointer-events: none;
    }
  }

  /* ---------- Botón de sonido ---------- */
  .boton-sonido {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: var(--toque-min);
    padding: 8px 20px 8px 8px;
    border-radius: var(--radio-pill);
    border: 1px solid var(--borde-fuerte);
    background: var(--superficie);
    color: var(--texto);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    transition: border-color .15s ease, box-shadow .2s ease, transform 160ms var(--salida);
  }
  .boton-sonido[aria-pressed="true"] { border-color: var(--acento); box-shadow: var(--brillo-cian); }
  @media (hover: hover) and (pointer: fine) {
    .boton-sonido:hover { border-color: var(--acento); box-shadow: var(--brillo-cian); }
  }
  .boton-sonido:active { transform: scale(.97); }

  .portada-controles { display: flex; justify-content: center; align-items: center; gap: 10px; }
  .boton-pausa {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--borde);
    background: var(--superficie);
    color: var(--texto-2);
    cursor: pointer;
    transition: border-color .15s ease, color .15s ease, transform 160ms var(--salida);
  }
  .boton-pausa svg { width: 18px; height: 18px; }
  .boton-pausa .bp-seguir, .boton-pausa[aria-pressed="true"] .bp-pausa { display: none; }
  .boton-pausa[aria-pressed="true"] .bp-seguir { display: block; }
  .boton-pausa:active { transform: scale(.97); }
  @media (hover: hover) and (pointer: fine) {
    .boton-pausa:hover { border-color: var(--acento); color: var(--acento); }
  }
  .bs-parlante { width: 20px; height: 20px; color: var(--texto-2); margin-left: -2px; }
  .bs-icono {
    display: grid;
    place-items: center;
    width: 36px; height: 36px;
    border-radius: 50%;
    background: var(--acento-relleno);
    color: var(--sobre-acento);
  }
  .bs-play { width: 20px; height: 20px; }
  .bs-barras { display: none; gap: 3px; align-items: end; height: 14px; }
  .bs-barras i { width: 3px; height: 14px; background: currentColor; transform-origin: bottom; animation: barra .6s ease-in-out infinite alternate; }
  .bs-barras i:nth-child(2) { animation-delay: -.2s; }
  .bs-barras i:nth-child(3) { animation-delay: -.4s; }
  @keyframes barra { from { transform: scaleY(.29); } to { transform: scaleY(1); } }
  .boton-sonido[aria-pressed="true"] .bs-play { display: none; }
  .boton-sonido[aria-pressed="true"] .bs-barras { display: flex; }

  /* ---------- Acciones ---------- */
  .portada-botones { display: grid; gap: 12px; }
  @media (min-width: 480px) {
    .portada-botones { display: flex; flex-wrap: wrap; }
  }
  .prueba-social {
    display: flex;
    align-items: center;
    gap: 14px;
    color: var(--texto-2);
    font-size: 15px;
  }
  .ps-numero {
    flex: none;
    font-size: 22px;
    font-weight: 700;
    color: var(--texto);
  }
  .prueba-social .pendiente { margin-left: 4px; }
</style>
