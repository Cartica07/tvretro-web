---
import { sitio, enlaceRed, esPendiente } from '../lib/sitio';
import BotonWhatsApp from './BotonWhatsApp.astro';

const p = sitio.portada;
// "*palabra*" → palabra resaltada.
const partesTitulo = p.titulo.split(/(\*[^*]+\*)/).filter(Boolean).map((t) =>
  t.startsWith('*') ? { brillo: true, t: t.slice(1, -1) } : { brillo: false, t },
);
const tiktok = enlaceRed('tiktok');
const seguidores = sitio.tiktok.seguidores.trim();
const datosPantalla = JSON.stringify({ color: sitio.pantalla.color, mensajes: sitio.pantalla.mensajes });
---
<section class="portada" id="inicio" aria-labelledby="portada-titulo">
  <div class="contenedor portada-grid">
    <div class="portada-texto">
      <p class="portada-etiqueta mono"><span class="punto" aria-hidden="true"></span>{p.etiqueta}</p>
      <h1 id="portada-titulo">
        {partesTitulo.map((x) => (x.brillo ? <span class="brillo">{x.t}</span> : x.t))}
      </h1>
      <p class="portada-subtitulo">{p.subtitulo}</p>
    </div>

    <div class="portada-tv">
      <figure class="tv" data-pantalla={datosPantalla}>
        <div class="tv-antenas" aria-hidden="true"><span></span><span></span></div>
        <div class="tv-cuerpo">
          <div class="tv-marco">
            <canvas
              class="tv-pantalla"
              width="512"
              height="256"
              role="img"
              aria-label="Pantalla de la TV RETRO escribiendo mensajes, dibujando un corazón, sonando una canción y mostrando la hora"
            ></canvas>
            <span class="tv-reflejo" aria-hidden="true"></span>
          </div>
          <div class="tv-lado" aria-hidden="true">
            <span class="tv-perilla"></span>
            <span class="tv-rejilla"></span>
            <span class="tv-led"></span>
          </div>
        </div>
        <div class="tv-patas" aria-hidden="true"><span></span><span></span></div>
        <figcaption class="solo-lectores">Animación de lo que muestra la pantalla de la TV RETRO.</figcaption>
      </figure>

      <button class="boton-sonido" type="button" aria-pressed="false">
        <span class="bs-icono" aria-hidden="true">
          <svg class="bs-play" viewBox="0 0 24 24"><path d="M8 5.5v13l10.5-6.5L8 5.5Z" fill="currentColor" /></svg>
          <span class="bs-barras"><i></i><i></i><i></i></span>
        </span>
        <span class="bs-texto" data-tocar={p.botonSonido} data-detener="Detener">{p.botonSonido}</span>
      </button>
      <p class="bs-nota">Sube el volumen: suena como la TV de verdad.</p>
    </div>

    <div class="portada-acciones">
        {p.destacados.length > 0 && (
          <ul class="destacados" aria-label="Lo más destacado">
            {p.destacados.map((d) => <li>{d}</li>)}
          </ul>
        )}
      <div class="portada-botones">
        <BotonWhatsApp texto={p.botonPrincipal} />
        <a class="boton boton-secundario" href="#versiones">{p.botonSecundario}</a>
      </div>
      {seguidores && (
        <p class="prueba-social">
          <span class="ps-numero mono">+{seguidores}</span>
          <span>
            personas siguen sus canciones en TikTok.
            {tiktok ? (
              <a href={tiktok} target="_blank" rel="noopener">Escúchalas aquí</a>
            ) : (
              <span class="pendiente">{esPendiente(sitio.contacto.tiktok) ? 'PENDIENTE: usuario de TikTok' : ''}</span>
            )}
          </span>
        </p>
      )}
    </div>
  </div>
</section>

<script>
  import { PantallaPixel, Programacion, escenaEscribir, escenaDibujo, escenaMusica, escenaReloj } from '../scripts/tv/pantalla';
  import { buzzer, CUMPLEANOS } from '../scripts/tv/sonido';

  const figura = document.querySelector<HTMLElement>('.tv[data-pantalla]');
  const lienzo = figura?.querySelector<HTMLCanvasElement>('canvas');
  if (figura && lienzo) {
    const { color, mensajes } = JSON.parse(figura.dataset.pantalla!) as { color: string; mensajes: string[] };
    figura.style.setProperty('--color-pantalla', color);

    const sinMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const pantalla = new PantallaPixel(lienzo, color);

    // Mensajes intercalados con dibujo, canción y reloj.
    const extras = [escenaDibujo(), escenaMusica('Tu canción'), escenaReloj()];
    const escenas = mensajes.flatMap((m, i) => [escenaEscribir(m), ...(i < extras.length ? [extras[i]] : [])]);
    const programa = new Programacion(pantalla, escenas, sinMovimiento);
    programa.dibujarYa();

    // Solo se anima cuando se ve (ahorra batería en el celular).
    let visible = true;
    const actualizar = () => (visible && !document.hidden && (!sinMovimiento || buzzer.sonando) ? programa.iniciar() : programa.detener());
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; actualizar(); }).observe(lienzo);
    document.addEventListener('visibilitychange', actualizar);

    // Botón "Escucha cómo suena".
    const boton = document.querySelector<HTMLButtonElement>('.boton-sonido')!;
    const etiqueta = boton.querySelector<HTMLElement>('.bs-texto')!;
    const marcar = (sonando: boolean) => {
      boton.setAttribute('aria-pressed', String(sonando));
      figura.classList.toggle('tv-sonando', sonando);
      etiqueta.textContent = sonando ? etiqueta.dataset.detener! : etiqueta.dataset.tocar!;
    };
    const terminar = () => { marcar(false); programa.soltar(); actualizar(); };
    boton.addEventListener('click', () => {
      if (buzzer.sonando && boton.getAttribute('aria-pressed') === 'true') { buzzer.detener(); return; }
      buzzer.tocar(CUMPLEANOS, terminar);
      programa.fijar(escenaMusica('Cumpleaños feliz', () => buzzer.estado()));
      marcar(true);
      actualizar();
    });
  }
</script>

<style>
  .portada { padding-block: clamp(28px, 6vw, 72px) clamp(40px, 8vw, 96px); }

  .portada-grid {
    display: grid;
    gap: 28px;
    grid-template-areas: "texto" "tv" "acciones";
  }
  .portada-texto { grid-area: texto; }
  .portada-tv { grid-area: tv; }
  .portada-acciones { grid-area: acciones; }

  @media (min-width: 900px) {
    .portada-grid {
      grid-template-columns: 1.05fr 1fr;
      grid-template-areas: "texto tv" "acciones tv";
      column-gap: 56px;
      row-gap: 32px;
      align-items: center;
    }
    .portada-texto { align-self: end; }
    .portada-acciones { align-self: start; }
  }

  .portada-etiqueta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 18px;
    padding: 6px 14px;
    border: 1px solid var(--borde);
    border-radius: var(--radio-pill);
    background: rgb(18 24 33 / .7);
    color: var(--acento);
    font-size: 13px;
    letter-spacing: .04em;
  }
  .punto {
    width: 8px; height: 8px;
    background: var(--acento);
    box-shadow: 0 0 10px var(--acento);
    animation: latido 1.6s steps(2, jump-none) infinite;
  }
  @keyframes latido { 50% { opacity: .25; } }

  h1 {
    font-size: clamp(38px, 9.5vw, 66px);
    font-weight: 700;
  }
  .brillo {
    color: var(--acento);
    text-shadow: 0 0 18px rgb(77 210 255 / .55), 0 0 2px rgb(77 210 255 / .9);
  }
  .portada-subtitulo {
    margin-top: 16px;
    max-width: 34ch;
    color: var(--texto-2);
    font-size: clamp(17px, 2.2vw, 20px);
  }

  .destacados {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 22px;
    padding: 0;
  }
  .destacados li {
    padding: 5px 11px;
    border-radius: var(--radio-sm);
    background: var(--superficie);
    border: 1px solid var(--borde);
    font-size: 13.5px;
    font-weight: 600;
  }

  /* ---------- La TV ---------- */
  .portada-tv { display: grid; justify-items: center; gap: 14px; }

  .tv {
    --color-pantalla: #4DD2FF;
    margin: 0;
    width: min(100%, 460px);
    display: grid;
    justify-items: center;
  }
  .tv-antenas { position: relative; width: 46%; height: 42px; }
  .tv-antenas span {
    position: absolute;
    bottom: 0;
    width: 3px;
    height: 48px;
    background: linear-gradient(var(--borde-fuerte), #1b2433);
    border-radius: 2px;
    transform-origin: bottom center;
  }
  .tv-antenas span:first-child { left: 34%; transform: rotate(-28deg); }
  .tv-antenas span:last-child { right: 34%; transform: rotate(24deg); }
  .tv-antenas span::before {
    content: "";
    position: absolute;
    top: -5px; left: -3px;
    width: 9px; height: 9px;
    background: var(--borde-fuerte);
  }

  .tv-cuerpo {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 14px;
    padding: 16px;
    border-radius: 22px;
    background: linear-gradient(160deg, #1c2533, #121821 60%);
    border: 1px solid var(--borde-fuerte);
    box-shadow:
      0 1px 0 rgb(255 255 255 / .06) inset,
      0 30px 60px -30px rgb(0 0 0 / .9),
      0 0 80px -20px rgb(77 210 255 / .25);
  }
  .tv-marco {
    position: relative;
    padding: 10px;
    border-radius: 14px;
    background: #05080B;
    box-shadow: 0 0 0 2px #0d131b inset, 0 2px 8px rgb(0 0 0 / .8) inset;
  }
  .tv-pantalla {
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 1;
    border-radius: 4px;
    image-rendering: pixelated;
    filter: drop-shadow(0 0 6px color-mix(in srgb, var(--color-pantalla) 55%, transparent));
  }
  .tv-reflejo {
    position: absolute;
    inset: 10px;
    border-radius: 4px;
    background: linear-gradient(155deg, rgb(255 255 255 / .07), transparent 38%);
    pointer-events: none;
  }
  .tv-lado {
    display: grid;
    align-content: space-between;
    justify-items: center;
    padding-block: 6px;
    width: clamp(34px, 9vw, 46px);
  }
  .tv-perilla {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: conic-gradient(from 20deg, #2b3647, #161e2a, #2b3647, #161e2a, #2b3647);
    border: 2px solid #33415A;
    box-shadow: 0 4px 8px rgb(0 0 0 / .5);
  }
  .tv-sonando .tv-perilla { animation: girar 2.4s linear infinite; }
  @keyframes girar { to { transform: rotate(360deg); } }
  .tv-rejilla {
    width: 70%;
    height: 34px;
    background: repeating-linear-gradient(to bottom, #2b3647 0 3px, transparent 3px 6px);
    border-radius: 2px;
  }
  .tv-led {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 10px var(--ok);
  }
  .tv-patas { display: flex; justify-content: space-between; width: 70%; }
  .tv-patas span { width: 18px; height: 12px; background: #1b2433; border-radius: 0 0 6px 6px; }

  /* ---------- Botón de sonido ---------- */
  .boton-sonido {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: var(--toque-min);
    padding: 8px 20px 8px 8px;
    border-radius: var(--radio-pill);
    border: 1px solid var(--borde-fuerte);
    background: var(--superficie);
    color: var(--texto);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    transition: border-color .15s ease, box-shadow .2s ease;
  }
  .boton-sonido:hover, .boton-sonido[aria-pressed="true"] { border-color: var(--acento); box-shadow: var(--brillo-cian); }
  .bs-icono {
    display: grid;
    place-items: center;
    width: 36px; height: 36px;
    border-radius: 50%;
    background: var(--acento-relleno);
    color: var(--sobre-acento);
  }
  .bs-play { width: 20px; height: 20px; }
  .bs-barras { display: none; gap: 3px; align-items: end; height: 14px; }
  .bs-barras i { width: 3px; background: currentColor; animation: barra .6s ease-in-out infinite alternate; }
  .bs-barras i:nth-child(2) { animation-delay: -.2s; }
  .bs-barras i:nth-child(3) { animation-delay: -.4s; }
  @keyframes barra { from { height: 4px; } to { height: 14px; } }
  .boton-sonido[aria-pressed="true"] .bs-play { display: none; }
  .boton-sonido[aria-pressed="true"] .bs-barras { display: flex; }
  .bs-nota { color: var(--texto-2); font-size: 13px; }

  /* ---------- Acciones ---------- */
  .portada-botones { display: grid; gap: 12px; }
  @media (min-width: 480px) {
    .portada-botones { display: flex; flex-wrap: wrap; }
  }
  .prueba-social {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 22px;
    color: var(--texto-2);
    font-size: 15px;
  }
  .ps-numero {
    flex: none;
    font-size: 22px;
    font-weight: 700;
    color: var(--texto);
  }
  .prueba-social .pendiente { margin-left: 4px; }
</style>
