---
/**
 * Logo provisional (texto + TV de píxeles). Cuando tengas el logo real,
 * guárdalo como src/assets/fotos/logo.svg y se cambia aquí en un paso.
 */
import { sitio } from '../lib/sitio';
---
<span class="logo">
  <svg class="logo-icono" viewBox="0 0 16 14" aria-hidden="true" shape-rendering="crispEdges">
    <rect x="4" y="0" width="1" height="2" fill="currentColor" />
    <rect x="11" y="0" width="1" height="2" fill="currentColor" />
    <rect x="5" y="2" width="1" height="1" fill="currentColor" />
    <rect x="10" y="2" width="1" height="1" fill="currentColor" />
    <rect x="1" y="3" width="14" height="10" rx="0" fill="none" stroke="currentColor" stroke-width="1" />
    <rect x="3" y="5" width="8" height="6" fill="var(--acento)" />
    <rect x="12" y="5" width="1" height="1" fill="currentColor" />
    <rect x="12" y="7" width="1" height="1" fill="currentColor" />
  </svg>
  <span class="logo-texto mono">{sitio.marca.nombre}</span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; }
  .logo-icono { width: 30px; height: auto; color: var(--texto); filter: drop-shadow(0 0 6px rgb(77 210 255 / .45)); }
  .logo-texto { font-weight: 700; font-size: 17px; letter-spacing: .06em; }
</style>
