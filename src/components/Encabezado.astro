---
import { sitio } from '../lib/sitio';
import BotonWhatsApp from './BotonWhatsApp.astro';
import Logo from './Logo.astro';
---
<header class="encabezado">
  <div class="contenedor encabezado-fila">
    <a class="encabezado-logo" href="#inicio" aria-label={`${sitio.marca.nombre}, ir al inicio`}>
      <Logo />
    </a>
    <BotonWhatsApp texto="Pedir" variante="compacto" />
  </div>
</header>

<style>
  .encabezado {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgb(11 15 20 / .72);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    border-bottom: 1px solid rgb(37 48 65 / .6);
  }
  .encabezado-fila {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 64px;
  }
  .encabezado-logo { color: var(--texto); text-decoration: none; display: inline-flex; padding: 6px 0; }
</style>
