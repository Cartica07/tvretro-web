---
/**
 * "¿Cuál Pepito es para ti?": cada versión con su personalidad (a quién se
 * lo das), sus ventajas, en qué celulares funciona y su botón de pedido.
 * Las dos TV se dibujan a escala por el tamaño de su pantalla (1,3" y 0,96")
 * hasta tener las medidas reales de cada caja.
 * Debajo: lo que traen las dos y, plegada, la tabla con todos los detalles.
 * En celular (menos de 900 px) se ve UNA a la vez con el selector Pro | Lite,
 * para no hacer tan larga la página; en computador, las dos lado a lado.
 */
import { sitio, esPendiente, textoPendiente } from '../lib/sitio';
import TvMadera from './TvMadera.astro';
import BotonWhatsApp from './BotonWhatsApp.astro';

const c = sitio.comparar;
const versiones = sitio.versiones;
// Tamaño relativo de cada TV: la Lite es 0,96 / 1,3 de la Pro.
const ESCALA: Record<string, number> = { wifi: 1, lite: +(0.96 / 1.3).toFixed(3) };
const disponible = (e: string) => e === 'disponible';
---
<section class="versiones" id="versiones" aria-labelledby="versiones-titulo">
  <div class="contenedor">
    <header class="seccion-cabeza">
      <h2 id="versiones-titulo">{c.titulo}</h2>
      {c.subtitulo && <p>{c.subtitulo}</p>}
    </header>

    <div class="v-elegir" role="group" aria-label="Elige una versión">
      {versiones.map((v, i) => (
        <button type="button" data-elegir={v.id} aria-pressed={i === 0 ? 'true' : 'false'}>{v.nombre}</button>
      ))}
    </div>

    <div class="v-grid">
      {versiones.map((v) => (
        <article class="v" data-version={v.id} data-pantalla={v.pantalla} data-activa="true" aria-labelledby={`v-${v.id}`}>
          <div class="v-escena">
            <div class="v-tv" style={`--escala: ${ESCALA[v.id]}`}>
              <TvMadera sufijo={`-${v.id}`} etiqueta={`${v.nombre} mostrando «${v.pantalla}»`} />
            </div>
          </div>

          <div class="v-cuerpo">
            <p class:list={['v-estado', { 'v-disponible': disponible(v.estado) }]}>
              {disponible(v.estado) ? 'Disponible' : 'Próximamente'}
            </p>
            <h3 id={`v-${v.id}`}>{v.nombre}</h3>
            <p class="v-para">{v.para}</p>
            {v.lema && <p class="v-lema">{v.lema}</p>}

            <ul class="v-puntos" role="list">
              {v.puntos.map((x) => (
                <li>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>
                  {x}
                </li>
              ))}
            </ul>

            <p class="v-funciona"><span>Funciona en</span>{v.funcionaEn}</p>

            <div class="v-pedir">
              <p class="v-precio">
                {esPendiente(v.precio) ? <span class="pendiente">{textoPendiente(v.precio)}</span> : v.precio}
              </p>
              <BotonWhatsApp
                texto={disponible(v.estado) ? `Pedir ${v.nombre}` : 'Quiero que me avisen'}
                mensaje={v.mensajeWhatsApp}
              />
            </div>
          </div>
        </article>
      ))}
    </div>

    {c.comunes && <p class="v-comunes">{c.comunes}</p>}

    {c.diferencias.length > 0 && (
      <details class="v-detalles">
        <summary>
          Ver todas las diferencias
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9.5 6 6 6-6" /></svg>
        </summary>
        <div class="v-tabla-marco">
          <table>
            <thead>
              <tr>
                <td></td>
                {versiones.map((v) => <th scope="col">{v.nombre}</th>)}
              </tr>
            </thead>
            <tbody>
              {c.diferencias.map(([tema, pro, lite]) => (
                <tr>
                  <th scope="row">{tema}</th>
                  <td>{pro}</td>
                  <td>{lite}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>
    )}
  </div>
</section>

<script>
  import { PantallaApp } from '../scripts/oled/pantallaApp';

  // Cada TV muestra su frase quieta, dibujada con el código de la app.
  for (const v of document.querySelectorAll<HTMLElement>('.v[data-pantalla]')) {
    const lienzo = v.querySelector('canvas');
    if (lienzo) new PantallaApp(lienzo).texto({ texto: v.dataset.pantalla ?? '' }, false);
  }

  // Selector Pro | Lite (solo se ve en celular; en computador salen las dos).
  const botones = [...document.querySelectorAll<HTMLButtonElement>('[data-elegir]')];
  const tarjetas = [...document.querySelectorAll<HTMLElement>('.v[data-version]')];
  const elegir = (id: string) => {
    for (const b of botones) b.setAttribute('aria-pressed', String(b.dataset.elegir === id));
    for (const t of tarjetas) t.dataset.activa = String(t.dataset.version === id);
  };
  for (const b of botones) b.addEventListener('click', () => elegir(b.dataset.elegir!));
  if (botones[0]) elegir(botones[0].dataset.elegir!);
</script>

<style>
  .versiones { padding-block: clamp(44px, 10vw, 120px); }

  .v-grid { display: grid; gap: 20px; margin-top: 16px; }
  @media (min-width: 900px) { .v-grid { grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 36px; } }

  /* Selector Pro | Lite: el mismo control segmentado de la muestra. */
  .v-elegir {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
    margin-top: 24px;
    padding: 4px;
    border-radius: var(--radio-pill);
    border: 1px solid var(--borde);
    background: var(--superficie);
  }
  .v-elegir button {
    min-height: 44px;
    border: 0;
    border-radius: var(--radio-pill);
    background: transparent;
    color: var(--texto-2);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    transition: background-color .15s ease, color .15s ease, transform 160ms var(--salida);
  }
  .v-elegir button:active { transform: scale(.97); }
  .v-elegir button[aria-pressed="true"] { background: var(--acento-relleno); color: var(--sobre-acento); }
  @media (max-width: 899px) {
    .v[data-activa="false"] { display: none; }
    .v { transition: opacity 180ms var(--salida); }
    @starting-style { .v[data-activa="true"] { opacity: 0; } }
  }
  @media (min-width: 900px) { .v-elegir { display: none; } }

  .v-grid > * { min-width: 0; }
  .v {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    border-radius: var(--radio-lg);
    border: 1px solid var(--borde);
    background: var(--superficie);
    overflow: hidden;
  }
  .v[data-version="wifi"] { border-color: rgb(77 210 255 / .35); }

  /* Las dos TV paradas sobre la misma línea: así se nota la diferencia de tamaño. */
  .v-escena {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    aspect-ratio: 4 / 3; /* cabe la Pro entera: las dos escenas miden igual */
    padding: 0 12% 6%;
    background:
      radial-gradient(60% 70% at 50% 62%, rgb(77 210 255 / .12), transparent 70%),
      linear-gradient(to bottom, #0E141C, var(--superficie));
    border-bottom: 1px solid var(--borde);
  }
  .v-tv { width: calc(78% * var(--escala)); }

  .v-cuerpo { display: flex; flex-direction: column; padding: clamp(22px, 3.4vw, 32px); }

  .v-estado {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    align-self: flex-start;
    font-size: 13px;
    font-weight: 600;
    color: var(--texto-2);
  }
  .v-estado::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--texto-2); }
  .v-disponible { color: var(--ok); }
  .v-disponible::before { background: var(--ok); box-shadow: 0 0 10px rgb(61 220 132 / .7); }

  .v h3 { margin-top: 10px; color: var(--texto-2); font-family: var(--fuente-pantalla), monospace; font-weight: 600; letter-spacing: 0; }
  .v-para { margin-top: 6px; font-size: clamp(24px, 3vw, 30px); font-weight: 700; line-height: 1.15; letter-spacing: -0.02em; text-wrap: balance; }
  .v-lema { margin-top: 10px; color: var(--texto-2); font-size: 17px; }

  .v-puntos { list-style: none; margin: 22px 0 0; padding: 0; display: grid; gap: 12px; }
  .v-puntos li { display: grid; grid-template-columns: 22px 1fr; gap: 10px; font-size: 16px; line-height: 1.45; }
  .v-puntos svg { width: 22px; height: 22px; fill: none; stroke: var(--acento); stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }

  .v-funciona {
    margin-top: 22px;
    padding-top: 16px;
    border-top: 1px solid var(--borde);
    font-size: 15px;
    color: var(--texto);
  }
  .v-funciona span { display: block; margin-bottom: 2px; color: var(--texto-2); font-size: 13px; font-weight: 600; }

  /* El botón queda abajo en las dos, aunque una tenga más puntos. */
  .v-pedir { margin-top: auto; padding-top: 22px; display: grid; gap: 12px; }
  .v-precio { font-size: 20px; font-weight: 700; }
  .v-pedir :global(.boton) { width: 100%; justify-content: center; }

  .v-comunes {
    margin-top: 28px;
    padding: 18px 22px;
    border-radius: var(--radio-md);
    background: var(--acento-fondo);
    color: var(--texto);
    font-size: 17px;
    max-width: none;
  }

  /* ---------- Tabla plegada ---------- */
  .v-detalles { margin-top: 20px; }
  .v-detalles summary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: var(--toque-min);
    padding: 0 4px;
    color: var(--acento);
    font-weight: 600;
    cursor: pointer;
    list-style: none;
    border-radius: 6px;
  }
  .v-detalles summary::-webkit-details-marker { display: none; }
  .v-detalles summary svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; transition: transform 200ms var(--salida); }
  .v-detalles[open] summary svg { transform: rotate(180deg); }

  .v-tabla-marco { margin-top: 10px; overflow-x: auto; border: 1px solid var(--borde); border-radius: var(--radio-md); }
  /* Cabe entera en el celular: nada de deslizar de lado para ver la Lite. */
  table { width: 100%; table-layout: fixed; border-collapse: collapse; font-size: 14px; line-height: 1.4; }
  th, td { padding: 10px 10px; text-align: left; vertical-align: top; border-bottom: 1px solid var(--borde); overflow-wrap: anywhere; }
  @media (min-width: 600px) { table { font-size: 15px; } th, td { padding: 12px 16px; } }
  tbody tr:last-child > * { border-bottom: 0; }
  thead th { font-family: var(--fuente-pantalla), monospace; font-size: 14px; color: var(--acento); }
  tbody th { width: 34%; color: var(--texto-2); font-weight: 600; }
</style>
