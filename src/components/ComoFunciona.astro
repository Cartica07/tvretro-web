---
/**
 * "Cómo funciona" en 3 pasos. Cada paso muestra la pantalla REAL de la TV en
 * ese momento: el QR del Wi-Fi y el código para vincularla (copiados del
 * firmware) y un mensaje (dibujado con el código de la app). Debajo, la Lite
 * con su pantalla de emparejar (copiada de su firmware).
 */
import { sitio } from '../lib/sitio';

const p = sitio.pasos;
const pantallas = ['qr', 'vincular', 'mensaje'];
const lite = p.lite?.titulo ? p.lite : null;
---
<section class="pasos" id="como-funciona" aria-labelledby="pasos-titulo">
  <div class="contenedor">
    <header class="seccion-cabeza">
      <h2 id="pasos-titulo">{p.titulo}</h2>
      {p.subtitulo && <p>{p.subtitulo}</p>}
    </header>

    <ol class="pasos-lista">
      {p.lista.map((x, i) => (
        <li>
          <div class="oled-app paso-pantalla">
            <canvas width="128" height="64" data-paso={pantallas[i]} role="img"
              aria-label={['Pepito muestra un código QR para conectarlo a tu Wi-Fi', 'Pepito muestra el código para vincularlo a tu cuenta', 'Pepito muestra tu mensaje'][i]}></canvas>
          </div>
          <div class="paso-texto">
            <span class="paso-num" aria-hidden="true">{i + 1}</span>
            <div>
              <h3>{x.titulo}</h3>
              <p>{x.texto}</p>
            </div>
          </div>
        </li>
      ))}
    </ol>

    {lite && (
      <div class="lite">
        <div class="oled-app lite-pantalla">
          <canvas width="128" height="64" data-paso="emparejar" role="img"
            aria-label="Pepito Lite muestra un PIN para emparejarlo con tu celular"></canvas>
        </div>
        <div class="lite-texto">
          <h3>{lite.titulo}</h3>
          {lite.texto && <p>{lite.texto}</p>}
        </div>
      </div>
    )}
  </div>
</section>

<script>
  import { PantallaApp } from '../scripts/oled/pantallaApp';
  import { dibujarPortalQr, dibujarVincular, dibujarEmparejarLite } from '../scripts/oled/pantallaFirmware';

  const lienzos = [...document.querySelectorAll<HTMLCanvasElement>('.paso-pantalla canvas, .lite-pantalla canvas')];
  if (lienzos.length) {
    const sinMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // Cuenta hacia atrás como en la TV, pero solo unos segundos cuando la ves
    // y luego queda quieta (nada se mueve más de 5 s sin poder detenerlo).
    const SEGUNDOS = 4;
    const cuentaAtras = (lienzo: HTMLCanvasElement, desde: number, pinta: (s: number) => void) => {
      pinta(desde);
      if (sinMovimiento) return;
      new IntersectionObserver(([e], obs) => {
        if (!e.isIntersecting) return;
        obs.disconnect();
        let s = desde;
        const reloj = window.setInterval(() => {
          pinta(--s);
          if (desde - s >= SEGUNDOS) clearInterval(reloj);
        }, 1000);
      }, { threshold: 0.6 }).observe(lienzo);
    };
    const arrancar = () => {
      for (const c of lienzos) {
        const p = new PantallaApp(c);
        const tipo = c.dataset.paso;
        if (tipo === 'qr') p.imagen(dibujarPortalQr());
        if (tipo === 'mensaje') p.texto({ texto: '¡Hola, Ana!' });
        // El código de la Pro vence a los 10 minutos; el PIN de la Lite, a los 5.
        if (tipo === 'vincular') cuentaAtras(c, 9 * 60 + 41, (s) => p.imagen(dibujarVincular('K7M4PQ', s)));
        if (tipo === 'emparejar') cuentaAtras(c, 4 * 60 + 52, (s) => p.imagen(dibujarEmparejarLite('482915', s)));
      }
    };
    new IntersectionObserver((e, obs) => {
      if (e.some((x) => x.isIntersecting)) { obs.disconnect(); arrancar(); }
    }, { rootMargin: '200px' }).observe(lienzos[0]);
  }
</script>

<style>
  .pasos { padding-block: clamp(44px, 10vw, 120px); border-top: 1px solid var(--borde); }

  .pasos-lista {
    list-style: none;
    margin: clamp(24px, 4vw, 36px) 0 0;
    padding: 0;
    display: grid;
    gap: 20px;
    counter-reset: paso;
  }
  /* En celular: pantallita a la izquierda y texto al lado (la mitad de alto). */
  @media (max-width: 899px) {
    .pasos-lista li { display: grid; grid-template-columns: minmax(0, 44%) 1fr; gap: 14px; align-items: center; }
    .pasos-lista .paso-texto { margin-top: 0; grid-template-columns: 1fr; gap: 6px; }
    .pasos-lista .paso-num { width: 26px; height: 26px; font-size: 14px; }
    .pasos-lista .paso-texto h3 { font-size: 17px; line-height: 1.2; }
    .pasos-lista p { margin-top: 2px; font-size: 14px; line-height: 1.45; }
  }
  @media (min-width: 900px) { .pasos-lista { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; } }

  .paso-pantalla { border-radius: 14px; }
  .paso-texto { display: grid; grid-template-columns: auto 1fr; gap: 14px; margin-top: 18px; }
  .paso-num {
    display: grid;
    place-items: center;
    width: 34px; height: 34px;
    border-radius: 50%;
    background: var(--acento-relleno);
    color: var(--sobre-acento);
    font-weight: 700;
    font-size: 16px;
  }
  .paso-texto h3 { line-height: 34px; }
  .paso-texto p { margin-top: 6px; color: var(--texto-2); font-size: 16px; max-width: 34ch; }

  .lite {
    margin-top: 24px;
    padding: 14px;
    border-radius: var(--radio-md);
    border: 1px dashed var(--borde-fuerte);
    display: grid;
    grid-template-columns: minmax(0, 44%) 1fr;
    gap: 14px;
    align-items: center;
  }
  @media (max-width: 599px) {
    .lite-texto h3 { font-size: 17px; line-height: 1.2; }
    .lite-texto p { font-size: 14px; line-height: 1.45; }
  }
  .lite-pantalla { border-radius: 12px; }
  .lite-texto p { margin-top: 6px; color: var(--texto-2); font-size: 16px; max-width: 52ch; }
  @media (min-width: 600px) {
    .lite { grid-template-columns: minmax(0, 220px) 1fr; padding: 20px 24px 20px 20px; gap: 24px; }
  }
</style>
