---
/**
 * Videos de TikTok. Al principio solo se ve una tarjeta liviana; el video de
 * TikTok se carga cuando alguien toca "play" (así la página sigue rápida).
 */
import { sitio, esPendiente, textoPendiente, idVideoTikTok, enlaceRed } from '../lib/sitio';

const v = sitio.videos;
const perfil = enlaceRed('tiktok');
const videos = v.lista
  .map((x, i) => ({ n: i + 1, id: esPendiente(x.enlace) ? null : idVideoTikTok(x.enlace), enlace: x.enlace, titulo: x.titulo }))
  .filter((x) => x.id);
---
{videos.length > 0 && (
  <section class="videos" id="tiktok" aria-labelledby="videos-titulo">
    <div class="contenedor">
      <header class="seccion-cabeza">
        <h2 id="videos-titulo">{v.titulo}</h2>
        {v.subtitulo && <p>{v.subtitulo}</p>}
      </header>
    </div>

    <ul class="videos-fila" role="list">
      {videos.map((x) => (
        <li class="video">
          {x.id ? (
            <button class="video-portada" type="button" data-id={x.id} aria-label={`Ver video: ${esPendiente(x.titulo) || !x.titulo ? 'canción ' + x.n : x.titulo}`}>
              <span class="video-play" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M8 5.5v13l10.5-6.5L8 5.5Z" fill="currentColor" /></svg>
              </span>
              <span class="video-nota mono" aria-hidden="true">♫ TV RETRO</span>
              <span class="video-titulo">
                {esPendiente(x.titulo) ? <span class="pendiente">{textoPendiente(x.titulo)}</span> : x.titulo}
              </span>
            </button>
          ) : (
            <div class="video-portada video-vacio">
              <span class="video-nota mono" aria-hidden="true">♫ TV RETRO</span>
              <span class="pendiente">{textoPendiente(x.enlace)}</span>
            </div>
          )}
        </li>
      ))}
    </ul>

    <div class="contenedor videos-pie">
      {perfil ? (
        <a class="boton boton-secundario" href={perfil} target="_blank" rel="noopener">Ver todas en TikTok</a>
      ) : (
        <span class="pendiente">PENDIENTE: usuario de TikTok (botón "Ver todas en TikTok")</span>
      )}
    </div>
  </section>
)}

<script>
  for (const b of document.querySelectorAll<HTMLButtonElement>('.video-portada[data-id]')) {
    b.addEventListener('click', () => {
      const marco = document.createElement('iframe');
      marco.src = `https://www.tiktok.com/player/v1/${b.dataset.id}?autoplay=1&music_info=1&description=0`;
      marco.title = b.getAttribute('aria-label') ?? 'Video de TikTok';
      marco.allow = 'autoplay; fullscreen; encrypted-media; picture-in-picture';
      marco.allowFullscreen = true;
      marco.className = 'video-marco';
      b.replaceWith(marco);
      marco.focus();
    });
  }
</script>

<style>
  .videos { padding-block: clamp(32px, 7vw, 88px); }

  .videos-fila {
    list-style: none;
    display: flex;
    gap: 16px;
    margin: 28px 0 0;
    padding: 4px max(var(--margen), calc((100vw - var(--ancho-max)) / 2 + var(--margen))) 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--margen);
    scrollbar-width: thin;
    scrollbar-color: var(--borde-fuerte) transparent;
  }
  .video { flex: none; width: clamp(272px, 80vw, 325px); scroll-snap-align: start; }

  .video-portada, .video :global(.video-marco) {
    width: 100%;
    aspect-ratio: 9 / 16;
    min-height: 0;
    border-radius: var(--radio-lg);
    border: 1px solid var(--borde);
    display: block;
  }
  .video-portada {
    position: relative;
    display: grid;
    place-items: center;
    padding: 18px;
    overflow: hidden;
    color: var(--texto);
    font: inherit;
    text-align: left;
    cursor: pointer;
    background:
      radial-gradient(120% 60% at 50% 0%, rgb(77 210 255 / .18), transparent 60%),
      repeating-linear-gradient(to bottom, rgb(77 210 255 / .05) 0 2px, transparent 2px 6px),
      var(--superficie);
    transition: border-color .15s ease, box-shadow .2s ease, transform 160ms var(--salida);
  }
  @media (hover: hover) and (pointer: fine) {
    .video-portada:hover { border-color: var(--acento); box-shadow: var(--brillo-cian); }
  }
  .video-portada:active { transform: scale(.98); }
  .video-play {
    display: grid;
    place-items: center;
    width: 72px; height: 72px;
    border-radius: 50%;
    background: var(--acento-relleno);
    color: var(--sobre-acento);
    box-shadow: 0 0 30px rgb(77 210 255 / .45);
  }
  .video-play svg { width: 34px; height: 34px; margin-left: 4px; }
  .video-nota { position: absolute; top: 16px; left: 18px; color: var(--acento); font-size: 13px; letter-spacing: .04em; }
  .video-titulo { position: absolute; left: 18px; right: 18px; bottom: 18px; font-weight: 600; font-size: 17px; line-height: 1.3; }
  .video-vacio { cursor: default; align-content: center; gap: 10px; text-align: center; }
  .video-vacio:hover { border-color: var(--borde); box-shadow: none; }
  .video :global(.video-marco) { background: #000; }

  .videos-pie { margin-top: 20px; }
</style>
