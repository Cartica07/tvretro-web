---
/**
 * Botón de WhatsApp con el mensaje ya escrito.
 * Mientras falte el número en sitio.yaml, se ve igual pero con la etiqueta PENDIENTE.
 */
import { enlaceWhatsApp, sitio } from '../lib/sitio';

interface Props { texto: string; mensaje?: string; variante?: 'principal' | 'compacto'; clase?: string }
const { texto, mensaje = sitio.contacto.mensajeWhatsApp, variante = 'principal', clase = '' } = Astro.props;
const enlace = enlaceWhatsApp(mensaje);
---
<a
  class:list={['boton', 'boton-principal', 'boton-whatsapp', `bw-${variante}`, clase, { 'bw-pendiente': !enlace }]}
  href={enlace ?? '#'}
  target={enlace ? '_blank' : undefined}
  rel={enlace ? 'noopener' : undefined}
  aria-label={enlace ? `${texto} (se abre WhatsApp)` : `${texto} (falta el número de WhatsApp)`}
>
  <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
    <path d="M12 2.2a9.8 9.8 0 0 0-8.4 14.9L2.3 21.8l4.8-1.3A9.8 9.8 0 1 0 12 2.2Zm0 17.8a8 8 0 0 1-4.1-1.1l-.3-.2-2.8.8.8-2.8-.2-.3A8 8 0 1 1 12 20Zm4.4-6c-.2-.1-1.4-.7-1.7-.8-.2-.1-.4-.1-.5.1l-.8 1c-.1.2-.3.2-.5.1a6.5 6.5 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.5-.4h-.5a.9.9 0 0 0-.7.3 2.8 2.8 0 0 0-.9 2.1 4.9 4.9 0 0 0 1 2.6 11.2 11.2 0 0 0 4.3 3.8c1.6.7 2.2.7 3 .6a2.6 2.6 0 0 0 1.7-1.2 2.1 2.1 0 0 0 .2-1.2c-.1-.2-.3-.2-.5-.3Z"/>
  </svg>
  <span>{texto}</span>
  {!enlace && variante === 'principal' && <span class="pendiente bw-marca">PENDIENTE: número</span>}
  {!enlace && variante === 'compacto' && <span class="bw-punto" title="PENDIENTE: número de WhatsApp"></span>}
</a>

<style>
  .boton-whatsapp { position: relative; }
  .bw-compacto { min-height: 40px; padding: 8px 16px; font-size: 15px; }
  .bw-compacto svg { width: 18px; height: 18px; }
  .bw-marca {
    position: absolute;
    top: -12px;
    right: -6px;
    font-size: 10px;
    padding: 0 6px;
    background: #2A1F08;
    pointer-events: none;
  }
  .bw-punto {
    position: absolute;
    top: -3px;
    right: -3px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--aviso);
    border: 2px solid var(--fondo);
  }
</style>
